        "cellHeight": "sm",
        "footer": { "countRows": false, "enablePagination": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Request %" }]
      },
      "title": "Per-Node CPU Requests vs Allocatable",
      "type": "table",
      "targets": [
        {
          "expr": "sum by (cluster, node) (kube_node_status_allocatable{resource=\"cpu\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "expr": "sum by (cluster, node) (kube_pod_container_resource_requests{resource=\"cpu\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "B"
        },
        {
          "expr": "sum by (cluster, node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "C"
        },
        {
          "expr": "sum by (cluster, node) (kube_pod_container_resource_requests{resource=\"cpu\", cluster=~\"$cluster\"}) / sum by (cluster, node) (kube_node_status_allocatable{resource=\"cpu\", cluster=~\"$cluster\"}) * 100",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": { "byField": "node" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "cluster 2": true, "cluster 3": true, "cluster 4": true },
            "renameByName": { "cluster 1": "Cluster", "node": "Node", "Value #A": "Allocatable", "Value #B": "Requests", "Value #C": "Usage", "Value #D": "Request %" }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
